{
  "name": "polypharmacy-coordinator-mcp-server",
  "version": "1.0.0",
  "description": "Local Model Context Protocol (MCP) server for Polypharmacy Coordinator",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node ../node_modules/esbuild/bin/esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node ../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}

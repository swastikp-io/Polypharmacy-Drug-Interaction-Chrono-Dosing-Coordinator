{
  "name": "polypharmacy-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "node ./node_modules/vite/bin/vite.js",
    "server:dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "build": "npm run client:build && npm run server:build && npm run build:mcp",
    "build:mcp": "node ./node_modules/esbuild/bin/esbuild mcp-server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=mcp-server/dist/index.js",
    "client:build": "node ./node_modules/vite/bin/vite.js build",
    "server:build": "node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "db:reset": "node ./node_modules/tsx/dist/cli.mjs scripts/seed.ts --reset",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit && node ./node_modules/typescript/bin/tsc -p mcp-server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/multer": "^2.3.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
